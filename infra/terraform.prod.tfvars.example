# Copy values into terraform.prod.tfvars
environment = "prod"

terraform_state_bucket = "my-company-terraform-state"
terraform_state_key    = "gig-demo/prod/terraform.tfstate"
terraform_lock_table   = "gig-demo-tf-lock-prod"

frontend_public_url = "https://app.example.com"
api_public_url      = "https://api.example.com"
images_public_url   = "https://images.example.com"
route53_zone_id     = "Z0123456789ABCDEFGHIJ"

github_connection_arn = "arn:aws:codestar-connections:us-east-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
github_repository_id  = "myorg/gig-demo"
github_branch         = "main"

# Optional app tuning (defaults shown; omit to use defaults)
# images_cdn_base_url = ""  # empty → use images_public_url
# text_moderation_toxic_score_threshold = 0.65
# image_moderation_rekognition_min_confidence   = 40
# image_moderation_manual_review_min_confidence = 55
# image_moderation_auto_reject_min_confidence   = 75

# Stripe (leave empty to disable payments)
# stripe_secret_key      = "sk_live_..."   # stored as SecureString in SSM; rotate out-of-band
# stripe_webhook_secret  = "whsec_..."     # single webhook secret for platform + Connect events
# stripe_publishable_key = "pk_live_..."   # injected into frontend build as VITE_STRIPE_PUBLISHABLE_KEY
# platform_fee_percent   = 10              # % of job budget retained as platform fee (default: 10)
