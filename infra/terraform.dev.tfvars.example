# Copy values into terraform.dev.tfvars
environment = "dev"

terraform_state_bucket = "my-company-terraform-state"
terraform_state_key    = "gig-demo/dev/terraform.tfstate"
terraform_lock_table   = "gig-demo-tf-lock-dev"

frontend_public_url = "https://app-dev.example.com"
api_public_url      = "https://api-dev.example.com"
images_public_url   = "https://images-dev.example.com"
route53_zone_id     = "Z0123456789ABCDEFGHIJ"

github_connection_arn = "arn:aws:codestar-connections:us-east-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
github_repository_id  = "myorg/gig-demo"
github_branch         = "main"

# Optional app tuning (defaults shown; omit to use defaults)
# images_cdn_base_url = ""  # empty → use images_public_url
# text_moderation_toxic_score_threshold = 0.65
